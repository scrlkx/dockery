<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk" version="4.0"/>
    <requires lib="Adw" version="1.0"/>
    <template class="ConnectionDialog" parent="AdwWindow">
        <property name="modal">True</property>
        <property name="title" translatable="yes">Add Connection</property>
        <property name="default-width">450</property>
        <property name="content">
            <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                    <object class="AdwHeaderBar">
                        <child type="start">
                            <object class="GtkButton" id="cancel_button">
                                <property name="label" translatable="yes">Cancel</property>
                                <property name="action-name">window.close</property>
                            </object>
                        </child>
                        <child type="end">
                            <object class="GtkButton" id="add_button">
                                <property name="label" translatable="yes">Add</property>
                                <style>
                                    <class name="suggested-action"/>
                                </style>
                            </object>
                        </child>
                    </object>
                </child>
                <child>
                    <object class="AdwPreferencesPage">
                        <child>
                            <object class="AdwPreferencesGroup">
                                <child>
                                    <object class="AdwEntryRow" id="name_entry">
                                        <property name="title" translatable="yes">Name</property>
                                    </object>
                                </child>
                                <child>
                                    <object class="AdwEntryRow" id="uri_entry">
                                        <property name="title" translatable="yes">URI</property>
                                        <property name="text">unix:///var/run/docker.sock</property>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </property>
    </template>
</interface>
